# ---------------------------------------------------------------- Serveur
NODE_ENV=development
PORT=3000
# Derrière un reverse proxy (nginx, Cloudflare) : true pour que le rate limiting voie la vraie IP
TRUST_PROXY=false

# Origines navigateur autorisées (CORS), séparées par des virgules.
# Obligatoire en production. En dev, par défaut : http://localhost:3000 et http://localhost:3001 (front Next.js)
CORS_ORIGINS=http://localhost:3001

# ------------------------------------------------------- Base de données
# Dev : SQLite (fichier local, schéma synchronisé automatiquement)
DB_TYPE=sqlite
DB_PATH=./data/dev.sqlite
# Production : PostgreSQL + migrations (synchronize désactivé automatiquement quand NODE_ENV=production)
# DB_TYPE=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=postgres
# DB_PASSWORD=changeme
# DB_NAME=trocoin
# DB_SSL=false
# Forcer l'exécution des migrations au démarrage hors production : DB_MIGRATIONS_RUN=true
# Désactiver la synchronisation en dev : DB_SYNCHRONIZE=false

# ------------------------------------------------------------------- JWT
# En production : obligatoire, 32 caractères minimum, jamais une valeur par défaut.
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------- SMS
# mock : le code OTP est affiché dans les logs et via GET /dev/last-otp/:phone (jamais en production)
SMS_PROVIDER=mock

# -------------------------------------------------------------- Paiement
# mock : séquestre simulé | stripe : Stripe Connect (STRIPE_SECRET_KEY requis)
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
# URLs de retour après l'onboarding Stripe Connect (page du front)
STRIPE_CONNECT_RETURN_URL=http://localhost:3001/compte/paiements?stripe=retour
STRIPE_CONNECT_REFRESH_URL=http://localhost:3001/compte/paiements?stripe=rafraichir

# --------------------------------------------------------- Notifications
# mock : journalisées en console (push / SMS). Brancher Firebase Cloud Messaging en production.
NOTIFICATION_PROVIDER=mock
# Fréquence de vérification des alertes de recherche (expression cron, défaut : toutes les 5 minutes)
SAVED_SEARCH_CRON=*/5 * * * *

# ----------------------------------------------------------------- Divers
# Annonces gratuites par compte particulier sur 30 jours glissants
FREE_LISTINGS_PER_30_DAYS=20
# Limite globale de requêtes par IP et par minute
THROTTLE_LIMIT=100

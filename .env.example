# ---------------------------------------------------------------- Serveur
NODE_ENV=development
PORT=3000
# Derrière un reverse proxy (Render, Railway, nginx, Cloudflare) : true pour que le
# rate limiting voie la vraie IP du client. Obligatoire chez tous les hébergeurs PaaS.
TRUST_PROXY=false
# Version affichée par GET /health et envoyée à Sentry (ex. le SHA du commit)
# APP_VERSION=

# Origines navigateur autorisées (CORS), séparées par des virgules.
# Obligatoire en production, limité aux vrais domaines du site :
#   CORS_ORIGINS=https://www.trocoin.fr,https://trocoin.fr
# En dev, par défaut : http://localhost:3000 et http://localhost:3001 (front Next.js)
CORS_ORIGINS=http://localhost:3001

# ------------------------------------------------------- Base de données
# Dev : SQLite (fichier local, schéma synchronisé automatiquement)
DB_TYPE=sqlite
DB_PATH=./data/dev.sqlite
# Production : PostgreSQL obligatoire, schéma créé UNIQUEMENT par les migrations
# (src/migrations, exécutées automatiquement au démarrage quand NODE_ENV=production).
# Soit une URL complète (Neon, Render, Railway, Supabase…) :
# DB_TYPE=postgres
# DATABASE_URL=postgresql://user:motdepasse@hote:5432/trocoin?sslmode=require
# Soit les variables séparées :
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=postgres
# DB_PASSWORD=changeme
# DB_NAME=trocoin
# DB_SSL=false            # true si l'hébergeur impose TLS (déduit automatiquement de ?sslmode=require)
# DB_POOL_MAX=5           # taille du pool ; les offres gratuites limitent souvent à ~20 connexions
# Hors production : DB_MIGRATIONS_RUN=true pour exécuter les migrations au démarrage,
# DB_SYNCHRONIZE=false pour désactiver la synchronisation automatique du schéma.

# ------------------------------------------------------------------- JWT
# En production : obligatoire, 32 caractères minimum, jamais une valeur par défaut,
# DIFFÉRENT de celui du dev. Générer 48 octets aléatoires :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
# Durée du jeton d'accès (court : il n'est pas révocable). Le refresh token, lui,
# est stocké en base (table refresh_tokens), tourné à chaque usage et révocable.
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30

# ------------------------------------------------------------------- SMS
# mock   : le code OTP est affiché dans les logs et via GET /dev/last-otp/:phone
#          (interdit en production : le démarrage est refusé).
# vonage : VONAGE_API_KEY, VONAGE_API_SECRET, SMS_SENDER requis (vérifiés au démarrage)
# twilio : TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_FROM requis (vérifiés au démarrage)
# vonage : implémenté (src/sms/vonage-sms.provider.ts, API rest.nexmo.com/sms/json).
# twilio : NON implémenté (aucun identifiant Twilio disponible pour le tester).
SMS_PROVIDER=mock
# VONAGE_API_KEY=
# VONAGE_API_SECRET=
# SMS_SENDER=Trocoin
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+33XXXXXXXXX
# Tests uniquement : simule une panne du fournisseur (l'inscription répond 503)
# SMS_MOCK_FAIL=false

# -------------------------------------------------------------- Paiement
# mock     : séquestre simulé (dev/tests uniquement, interdit en production)
# disabled : paiement sécurisé indisponible, endpoints en 503 (seul mode autorisé en
#            production tant que Stripe/PayPal ne sont pas configurés)
# stripe   : Stripe Connect (STRIPE_SECRET_KEY requis) · paypal : PayPal (PAYPAL_ENV)
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
# Secret de signature du webhook (Stripe → Developers → Webhooks → endpoint
# https://<api>/transactions/webhook/stripe, évènements checkout.session.completed / expired,
# checkout.session.async_payment_succeeded / failed, payment_intent.canceled, charge.refunded).
# Obligatoire avec PAYMENT_PROVIDER=stripe. Le paiement passe par Stripe Checkout (page hébergée,
# capture différée) : aucune clé publiable n'est nécessaire côté front. Les URL de retour sont
# construites à partir de SITE_URL (section E-mail).
STRIPE_WEBHOOK_SECRET=
# URLs de retour après l'onboarding Stripe Connect (page du front)
STRIPE_CONNECT_RETURN_URL=http://localhost:3001/compte/paiements?stripe=retour
STRIPE_CONNECT_REFRESH_URL=http://localhost:3001/compte/paiements?stripe=rafraichir
# PAYPAL_ENV=sandbox

# --------------------------------------------------------- Notifications
# mock : journalisées en console (dev uniquement)
# none : notifications in-app seulement, ni push ni SMS (autorisé en production)
NOTIFICATION_PROVIDER=mock
# Fréquence de vérification des alertes de recherche (expression cron, défaut : toutes les 5 minutes)
SAVED_SEARCH_CRON=*/5 * * * *

# ---------------------------------------------------------------- E-mail
# mock   : rien n'est envoyé, le lien de réinitialisation est journalisé et exposé en dev
#          via GET /dev/last-reset-link/:email (interdit en production)
# none   : aucun envoi possible → « mot de passe oublié » répond 503 avec un message clair,
#          l'admin peut générer un mot de passe temporaire (autorisé en production)
# resend : RESEND_API_KEY + EMAIL_FROM requis (vérifiés au démarrage)
# brevo  : BREVO_API_KEY + EMAIL_FROM requis (vérifiés au démarrage)
# resend : implémenté, appel réel testé le 14 septembre 2026. Avec l'expéditeur de test
#          onboarding@resend.dev, Resend n'accepte que l'adresse du propriétaire du compte :
#          vérifier un domaine dans Resend puis EMAIL_FROM=Trocoin <no-reply@votre-domaine.fr>
#          pour écrire aux vrais utilisateurs.
# brevo  : l'appel HTTP n'est PAS implémenté (aucune clé pour le tester) : chaque envoi répond 503.
# Défaut si absent : mock en dev, none en production.
EMAIL_PROVIDER=mock

# Étiquettes transporteur (docs/etiquettes-transporteur.md) : mock (étiquette PDF et suivi simulés, dev/tests
# uniquement) ou none (503 explicite, le vendeur saisit son numéro de suivi). boxtal : phase 2, après les clés de test.
# Défaut si absent : mock en dev, none en production. SHIPPING_MOCK_FAIL=etiquette|adresse simule une panne.
SHIPPING_PROVIDER=mock
# boxtal : deux applications créées sur developer.boxtal.com (docs/etiquettes-transporteur.md §7).
#   BOXTAL_V3_ACCESS_KEY / BOXTAL_V3_SECRET_KEY : application API v3 (étiquettes, suivi, points relais)
#   BOXTAL_V1_LOGIN / BOXTAL_V1_PASSWORD         : application API v1 (cotation des transporteurs)
#   BOXTAL_ENV=sandbox (défaut : api.boxtal.build / test.envoimoinscher.com) ou production
# BOXTAL_V3_ACCESS_KEY=
# BOXTAL_V3_SECRET_KEY=
# BOXTAL_V1_LOGIN=
# BOXTAL_V1_PASSWORD=
# BOXTAL_ENV=sandbox
# RESEND_API_KEY=
# BREVO_API_KEY=
# EMAIL_FROM=Trocoin <no-reply@votre-domaine.fr>
# URL publique du site, utilisée dans les liens des e-mails (défaut : première origine CORS)
# En production, absente ou sur un ancien hébergeur (vercel.app, onrender.com) → https://www.trocoin.fr
# SITE_URL=https://www.trocoin.fr
# Tests uniquement : simule une panne du fournisseur d'e-mail
# EMAIL_MOCK_FAIL=false

# ---------------------------------------------------- Stockage des photos
# local : disque ./uploads servi par l'API (ÉPHÉMÈRE sur Render : perdu à chaque déploiement)
# s3    : bucket S3 ou compatible (Cloudflare R2 recommandé : 10 Go gratuits). Variables exactes :
STORAGE_PROVIDER=local
# S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=trocoin
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Facultative : URL publique du bucket (R2 → Settings → Public access → r2.dev ou domaine
# personnalisé). Sans elle, les URL restent /uploads/… et l'API relaie les objets (cache 1 an).
# S3_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# ------------------------------------------------- Rate limiting partagé
# Sans REDIS_URL : compteurs en mémoire, corrects pour UNE instance. Avec : partagés (Upstash, Render Key Value).
# REDIS_URL=rediss://default:<password>@<host>:6379

# ------------------------------------------------ Vérification SIRET (pro)
# api  : registre public recherche-entreprises.api.gouv.fr (sans clé) — défaut
# mock : réponses simulées (tests) · none : clé de Luhn seulement
# SIRENE_PROVIDER=api

# ------------------------------------------------------------ Monitoring
# Sentry : si SENTRY_DSN est absent, le monitoring est simplement désactivé.
# Aucune donnée personnelle envoyée (sendDefaultPii=false, corps de requête supprimé).
# SENTRY_DSN=https://xxxx@oXXXX.ingest.sentry.io/XXXX
# SENTRY_TRACES_SAMPLE_RATE=0.05

# ----------------------------------------------------------------- Divers
# Photos envoyées par compte et par 24 h (anti-abus ; 10 annonces complètes restent possibles)
MAX_PHOTOS_PER_DAY=150
# Annonces gratuites par compte particulier sur 30 jours glissants
FREE_LISTINGS_PER_30_DAYS=20
# Limite globale de requêtes par IP et par minute (stockage en mémoire : par instance,
# voir DEPLOIEMENT.md §Redis)
THROTTLE_LIMIT=100
